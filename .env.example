# Enterprise Multi-Agent Workforce Orchestrator Environment Variables
ENV=production
LOG_LEVEL=INFO

# Security & JWT Token Verification
JWT_SECRET_KEY=your_secure_random_hmac_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional Live LLM Providers (Defaults to deterministic offline fallback if empty)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
